{
    "num_classes": 10,

    "sample_rate": 22050,
    "target_duration": 88200,
    "spec": "mfcc",
    "n_mfcc": 40,
    "num_mels": 128,
    "fft_length": 2048,
    "hop_length": 512,
    "norm": "whiten",
    "stretch_param": [0.4, 0.4],

    "hidden_channels": 32,
    "num_layers": 5,
    "cnn_dropout": 0.3,

    "dropout": 0.4,

    "lr": 0.001,
    "batch_size": 32,
    "epochs": 20,
    "padding": 1,

    "scheduler_step_size": 5,
    "scheduler_gamma": 0.1,

    "weight_decay": 1e-4,

    "betas": [0.9, 0.999],
    "eps": 1e-8
}